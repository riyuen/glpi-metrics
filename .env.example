# GLPI API Configuration
# Copy this file to .env and fill in your values

# Your GLPI instance URL (no trailing slash)
VITE_GLPI_URL=https://your-glpi.example.com

# GLPI REST API app token (create one in GLPI: Setup → General → API)
VITE_GLPI_APP_TOKEN=your_app_token_here

# GLPI user token (from your GLPI profile: click your name → User token)
VITE_GLPI_USER_TOKEN=your_user_token_here
